+    @cute.kernel
+    def kernel(
+        self,
+        input_ptr: cute.Pointer,
+        output_ptr: cute.Pointer,
+        rows: Int32,
+        in_row_packs: Int32,
+        in_col_off: Int32,
+        nbytes: Int32,
+        recv_base: Int64,
+        flag_base: Int64,
+        send_base: Int64,
+        ctrl_base: Int64,
+        slot_bytes: Int64,
+        epoch_ptr: Int64,
+        stage_counter_ptr: Int64,
+        tail_counter_ptr: Int64,
+        poison_ptr: Int64,
